# ==================================================================
# EXAMPLE TEMPLATE CONFIGURATION (ШАБЛОН ДЛЯ GITHUB)
# ==================================================================

# --- TELEGRAM CONFIGURATION ---
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- API CREDENTIALS (Binance API Key / TigerTrade API Key) ---
TIGERTRADE_API_KEY=YOUR_API_KEY
TIGERTRADE_SECRET_KEY=YOUR_SECRET_KEY

# --- TIGERTRADE_SERVER_URL ---
# Варіант 1: Ф'ючерси Binance USDS-M Futures
TIGERTRADE_SERVER_URL=https://fapi.binance.com

# Варіант 2: Ф'ючерси Binance Testnet
# TIGERTRADE_SERVER_URL=https://testnet.binancefuture.com

# Варіант 3: Спотовий ринок Binance Spot Trading
# TIGERTRADE_SERVER_URL=https://api.binance.com

# Варіант 4: Десктопний шлюз TigerTrade Gateway (Локальний ПК)
# TIGERTRADE_SERVER_URL=http://127.0.0.1:8989
